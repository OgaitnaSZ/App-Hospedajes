generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model actividades {
  idActividad          String                 @id @default(dbgenerated("(uuid())")) @db.Char(36)
  nombre               String                 @db.Text
  descripcion          String                 @db.Text
  imagen               String                 @db.Text
  ciudad               String                 @db.Text
  precio               Float                  @db.Float
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime               @default(now()) @db.Timestamp(0)
  reservas_actividades reservas_actividades[]
}

model fotos {
  idFoto      String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idHospedaje String    @db.Char(36)
  url         String    @db.VarChar(255)
  sort        Int
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  updated_at  DateTime  @default(now()) @db.Timestamp(0)
  hospedaje   hospedaje @relation(fields: [idHospedaje], references: [idHospedaje], onUpdate: Restrict, map: "fotos_ibfk_1")

  @@index([idHospedaje], map: "fotos_ibfk_1")
}

model habitaciones {
  idHabitacion        String                @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idHospedaje         String?               @db.Char(36)
  numero              String                @db.VarChar(10)
  tipo                habitaciones_tipo
  precio              Float                 @db.Float
  capacidad           Int
  servicios           String?               @db.VarChar(255)
  created_at          DateTime              @default(now()) @db.Timestamp(0)
  updated_at          DateTime              @default(now()) @db.Timestamp(0)
  hospedaje           hospedaje?            @relation(fields: [idHospedaje], references: [idHospedaje], onDelete: Restrict, onUpdate: Restrict, map: "habitaciones_ibfk_1")
  reservas_hospedajes reservas_hospedajes[]

  @@index([idHospedaje], map: "habitaciones_ibfk_1")
}

model hospedaje {
  idHospedaje         String                @id @default(dbgenerated("(uuid())")) @db.Char(36)
  titulo              String                @db.VarChar(150)
  descripcion         String?               @db.Text
  servicios           String                @db.VarChar(255)
  estrellas           Int?
  telefono            String                @db.VarChar(20)
  ciudad              String                @db.VarChar(100)
  direccion           String                @db.VarChar(255)
  coordenadas         String                @db.Text
  destacado           Boolean
  created_at          DateTime              @default(now()) @db.Timestamp(0)
  updated_at          DateTime              @default(now()) @db.Timestamp(0)
  estado              hospedaje_estado?     @default(desactivado)
  fotos               fotos[]
  habitaciones        habitaciones[]
  resena              resena[]
  reservas_hospedajes reservas_hospedajes[]
}

model password_resets {
  email      String   @db.VarChar(255)
  token      String   @id @db.VarChar(32)
  expiry     DateTime @db.DateTime(0)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

model resena {
  idResena     String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idUsuario    String    @db.Char(36)
  idHospedaje  String    @db.Char(36)
  idHabitacion String    @db.Char(36)
  calificacion Int?
  comentario   String?   @db.Text
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  updated_at   DateTime  @default(now()) @db.Timestamp(0)
  usuario      usuario   @relation(fields: [idUsuario], references: [idUsuario], onUpdate: Restrict, map: "resena_ibfk_1")
  hospedaje    hospedaje @relation(fields: [idHospedaje], references: [idHospedaje], onUpdate: Restrict, map: "resena_ibfk_2")

  @@index([idUsuario], map: "resena_ibfk_1")
  @@index([idHospedaje], map: "resena_ibfk_2")
}

model usuario {
  idUsuario            String                 @id @default(dbgenerated("(uuid())")) @db.Char(36)
  nombre               String                 @db.VarChar(100)
  apellido             String                 @db.VarChar(100)
  email                String                 @unique(map: "email") @db.VarChar(150)
  telefono             String?                @db.VarChar(20)
  password             String                 @db.VarChar(255)
  rol                  usuario_rol
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime               @default(now()) @db.Timestamp(0)
  pagos_hospedajes     pagos_hospedajes[]
  resena               resena[]
  reservas_actividades reservas_actividades[]
  reservas_hospedajes  reservas_hospedajes[]
}

model suscripcionesNewsletter {
  idSubscripcion String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  email          String   @unique(map: "email") @db.VarChar(30)
  created_at     DateTime @default(now()) @db.Timestamp(0)
  updated_at     DateTime @default(now()) @db.Timestamp(0)

  @@map("suscripciones_newsletter")
}

model servicios {
  idServicio  Int            @id @default(autoincrement())
  tipo        servicios_tipo
  nombre      String         @db.VarChar(255)
  descripcion String?        @db.Text
  created_at  DateTime       @default(now()) @db.Timestamp(0)
  updated_at  DateTime       @default(now()) @db.Timestamp(0)
}

model reservas_actividades {
  idReserva         String                      @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idUsuario         String                      @db.VarChar(36)
  idActividad       String                      @db.VarChar(36)
  fecha             DateTime                    @db.Date
  personas          Int
  precioTotal       Float                       @db.Float
  estado            reservas_actividades_estado
  created_at        DateTime                    @default(now()) @db.Timestamp(0)
  updated_at        DateTime                    @default(now()) @db.Timestamp(0)
  pagos_actividades pagos_actividades[]
  actividades       actividades                 @relation(fields: [idActividad], references: [idActividad], onDelete: Cascade, map: "fk_actividad")
  usuario           usuario                     @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade, map: "fk_usuario")

  @@index([idActividad], map: "fk_actividad")
  @@index([idUsuario], map: "fk_usuario")
}

model pagos_actividades {
  idPago               String                   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idReserva            String                   @db.Char(36)
  idUsuario            String                   @db.Char(36)
  nombre               String                   @db.Text
  apellido             String                   @db.Text
  dni                  String                   @db.Text
  direccion            String                   @db.Text
  email                String                   @db.Text
  telefono             String                   @db.Text
  monto                Float                    @db.Float
  idPreferencia        String                   @db.VarChar(64)
  estado               pagos_actividades_estado @default(pendiente)
  created_at           DateTime                 @default(now()) @db.Timestamp(0)
  updated_at           DateTime                 @default(now()) @db.Timestamp(0)
  reservas_actividades reservas_actividades     @relation(fields: [idReserva], references: [idReserva], onUpdate: Restrict, map: "fk_pagos_actividades_reserva")

  @@index([idReserva], map: "fk_pagos_actividades_reserva")
  @@index([idUsuario], map: "pago_ibfk_2")
}

model pagos_hospedajes {
  idPago              String                  @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idReserva           String                  @db.Char(36)
  idUsuario           String                  @db.Char(36)
  nombre              String                  @db.Text
  apellido            String                  @db.Text
  dni                 String                  @db.Text
  direccion           String                  @db.Text
  email               String                  @db.Text
  telefono            String                  @db.Text
  monto               Float                   @db.Float
  idPreferencia       String                  @db.VarChar(64)
  estado              pagos_hospedajes_estado @default(pendiente)
  created_at          DateTime                @default(now()) @db.Timestamp(0)
  updated_at          DateTime                @default(now()) @db.Timestamp(0)
  reservas_hospedajes reservas_hospedajes     @relation(fields: [idReserva], references: [idReserva], onUpdate: Restrict, map: "fk_pagos_hospedajes_reserva")
  usuario             usuario                 @relation(fields: [idUsuario], references: [idUsuario], onUpdate: Restrict, map: "pagos_hospedajes_ibfk_2")

  @@index([idReserva], map: "fk_pagos_hospedajes_reserva")
  @@index([idUsuario], map: "pago_ibfk_2")
}

model reservas_hospedajes {
  idReserva        String                     @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idUsuario        String                     @db.Char(36)
  idHospedaje      String                     @db.Char(36)
  idHabitacion     String                     @db.Char(36)
  fechaInicio      DateTime                   @db.Date
  fechaFin         DateTime                   @db.Date
  personas         Int
  precioTotal      Float                      @db.Float
  estado           reservas_hospedajes_estado
  created_at       DateTime                   @default(now()) @db.Timestamp(0)
  updated_at       DateTime                   @default(now()) @db.Timestamp(0)
  pagos_hospedajes pagos_hospedajes[]
  usuario          usuario                    @relation(fields: [idUsuario], references: [idUsuario], onUpdate: Restrict, map: "reservas_hospedajes_ibfk_1")
  hospedaje        hospedaje                  @relation(fields: [idHospedaje], references: [idHospedaje], onUpdate: Restrict, map: "reservas_hospedajes_ibfk_2")
  habitaciones     habitaciones               @relation(fields: [idHabitacion], references: [idHabitacion], onUpdate: Restrict, map: "reservas_hospedajes_ibfk_3")

  @@index([idUsuario], map: "reservas_ibfk_1")
  @@index([idHospedaje], map: "reservas_ibfk_2")
  @@index([idHabitacion], map: "reservas_ibfk_3")
}

enum habitaciones_tipo {
  individual
  doble
  suite
  deluxe
}

enum servicios_tipo {
  hospedaje
  habitacion
}

enum reservas_actividades_estado {
  pendiente
  concretado
  pendiente_de_cancelacion @map("pendiente de cancelacion")
  cancelado
}

enum reservas_hospedajes_estado {
  pendiente
  concretado
  pendiente_de_cancelacion @map("pendiente de cancelacion")
  cancelado
}

enum pagos_actividades_estado {
  pendiente
  aprobado
  rechazado
}

enum pagos_hospedajes_estado {
  pendiente
  aprobado
  rechazado
}

enum usuario_rol {
  administrador
  huesped
}

enum hospedaje_estado {
  activo
  desactivado
  eliminado
}

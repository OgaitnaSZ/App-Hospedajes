generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model actividades {
  id          String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  nombre      String   @db.Text
  descripcion String   @db.Text
  imagen      String   @db.Text
  ciudad      String   @db.Text
  precio      Float    @db.Float
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.Timestamp(0)
}

model fotos {
  idFoto      String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idHospedaje String    @db.Char(36)
  path        String    @db.VarChar(255)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  updated_at  DateTime  @default(now()) @db.Timestamp(0)
  hospedaje   hospedaje @relation(fields: [idHospedaje], references: [idHospedaje], onUpdate: Restrict, map: "fotos_ibfk_1")

  @@index([idHospedaje], map: "fotos_ibfk_1")
}

model habitaciones {
  idHabitacion String            @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idHospedaje  String?           @db.Char(36)
  numero       String            @db.VarChar(10)
  tipo         habitaciones_tipo
  precio       Decimal           @db.Decimal(10, 2)
  capacidad    Int
  servicios    String?           @db.VarChar(255)
  created_at   DateTime          @default(now()) @db.Timestamp(0)
  updated_at   DateTime          @default(now()) @db.Timestamp(0)
  hospedaje    hospedaje?        @relation(fields: [idHospedaje], references: [idHospedaje], onDelete: Restrict, onUpdate: Restrict, map: "habitaciones_ibfk_1")
  reservas     reservas[]

  @@index([idHospedaje], map: "habitaciones_ibfk_1")
}

model hospedaje {
  idHospedaje  String         @id @default(dbgenerated("(uuid())")) @db.Char(36)
  titulo       String         @db.VarChar(150)
  descripcion  String?        @db.Text
  servicios    String         @db.VarChar(255)
  estrellas    Int
  telefono     String         @db.VarChar(20)
  ciudad       String         @db.VarChar(100)
  direccion    String         @db.VarChar(255)
  coordenadas  String         @db.Text
  imagen       String?        @db.Text
  destacado    Boolean
  created_at   DateTime       @default(now()) @db.Timestamp(0)
  updated_at   DateTime       @default(now()) @db.Timestamp(0)
  fotos        fotos[]
  habitaciones habitaciones[]
  resena       resena[]
  reservas     reservas[]
}

model pago {
  idPago        String            @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idReserva     String            @db.Char(36)
  idUsuario     String            @db.Char(36)
  nombre        String            @db.Text
  apellido      String            @db.Text
  dni           String            @db.Text
  direccion     String            @db.Text
  email         String            @db.Text
  telefono      String            @db.Text
  monto         Decimal           @db.Decimal(10, 2)
  idPreferencia String            @db.VarChar(64)
  estado        pago_estado       @default(pendiente)
  tipoReserva   pago_tipoReserva?
  created_at    DateTime          @default(now()) @db.Timestamp(0)
  updated_at    DateTime          @default(now()) @db.Timestamp(0)
  reservas      reservas          @relation(fields: [idReserva], references: [idReserva], onUpdate: Restrict, map: "pago_ibfk_1")
  usuario       usuario           @relation(fields: [idUsuario], references: [idUsuario], onUpdate: Restrict, map: "pago_ibfk_2")

  @@index([idReserva], map: "pago_ibfk_1")
  @@index([idUsuario], map: "pago_ibfk_2")
}

model password_resets {
  email      String   @db.VarChar(255)
  token      String   @id @db.VarChar(32)
  expiry     DateTime @db.DateTime(0)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

model resena {
  idResena     String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idUsuario    String    @db.Char(36)
  idHospedaje  String    @db.Char(36)
  idHabitacion String    @db.Char(36)
  calificacion Int
  comentario   String?   @db.Text
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  updated_at   DateTime  @default(now()) @db.Timestamp(0)
  usuario      usuario   @relation(fields: [idUsuario], references: [idUsuario], onUpdate: Restrict, map: "resena_ibfk_1")
  hospedaje    hospedaje @relation(fields: [idHospedaje], references: [idHospedaje], onUpdate: Restrict, map: "resena_ibfk_2")

  @@index([idUsuario], map: "resena_ibfk_1")
  @@index([idHospedaje], map: "resena_ibfk_2")
}

model reservas {
  idReserva    String       @id @default(dbgenerated("(uuid())")) @db.Char(36)
  idUsuario    String       @db.Char(36)
  idHospedaje  String       @db.Char(36)
  idHabitacion String       @db.Char(36)
  fechaInicio  DateTime     @db.Date
  fechaFin     DateTime     @db.Date
  personas     Int
  precioTotal  Decimal      @db.Decimal(10, 2)
  estado       String       @db.VarChar(30)
  created_at   DateTime     @default(now()) @db.Timestamp(0)
  updated_at   DateTime     @default(now()) @db.Timestamp(0)
  pago         pago[]
  usuario      usuario      @relation(fields: [idUsuario], references: [idUsuario], onUpdate: Restrict, map: "reservas_ibfk_1")
  hospedaje    hospedaje    @relation(fields: [idHospedaje], references: [idHospedaje], onUpdate: Restrict, map: "reservas_ibfk_2")
  habitaciones habitaciones @relation(fields: [idHabitacion], references: [idHabitacion], onUpdate: Restrict, map: "reservas_ibfk_3")

  @@index([idUsuario], map: "reservas_ibfk_1")
  @@index([idHospedaje], map: "reservas_ibfk_2")
  @@index([idHabitacion], map: "reservas_ibfk_3")
}

model usuario {
  idUsuario  String      @id @default(dbgenerated("(uuid())")) @db.Char(36)
  nombre     String      @db.VarChar(100)
  apellido   String      @db.VarChar(100)
  email      String      @unique(map: "email") @db.VarChar(150)
  telefono   String?     @db.VarChar(20)
  password   String      @db.VarChar(255)
  rol        usuario_rol
  created_at DateTime    @default(now()) @db.Timestamp(0)
  updated_at DateTime    @default(now()) @db.Timestamp(0)
  pago       pago[]
  resena     resena[]
  reservas   reservas[]
}

model suscripcionesNewsletter {
  idSubscripcion String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  email          String   @unique(map: "email") @db.VarChar(30)
  created_at     DateTime @default(now()) @db.Timestamp(0)
  updated_at     DateTime @default(now()) @db.Timestamp(0)

  @@map("suscripciones_newsletter")
}

model servicios {
  idServicio  Int            @id @default(autoincrement())
  tipo        servicios_tipo
  nombre      String         @db.VarChar(255)
  descripcion String?        @db.Text
  created_at  DateTime       @default(now()) @db.Timestamp(0)
  updated_at  DateTime       @default(now()) @db.Timestamp(0)
}

enum habitaciones_tipo {
  individual
  doble
  suite
  deluxe
}

enum usuario_rol {
  administrador
  cliente
  huesped
  EMPTY_ENUM_VALUE @map("")
}

enum servicios_tipo {
  hospedaje
  habitacion
}

enum pago_estado {
  pendiente
  aprobado
  rechazado
}

enum pago_tipoReserva {
  hospedaje
  actividad
}
